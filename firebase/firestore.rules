rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isDeckMember(userId, deckId) {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(userId)/decks/$(deckId)/members/$(request.auth.uid)
      );
    }

    match /users/{userId} {
      allow read, write: if isUser(userId);

      match /decks/{deckId} {
        allow read: if isUser(userId) || isDeckMember(userId, deckId);
        allow write: if isUser(userId);

        match /buttons/{buttonId} {
          allow read: if isUser(userId) || isDeckMember(userId, deckId);
          allow write: if isUser(userId);
        }

        match /members/{memberId} {
          allow read: if isUser(userId) || request.auth.uid == memberId;
          allow write: if isUser(userId);
          // An operator can drop their own membership (leaving, or deleting their account).
          allow delete: if request.auth.uid == memberId;
        }

        match /profiles/{profileId} {
          allow read: if isUser(userId) || isDeckMember(userId, deckId);
          allow write: if isUser(userId);
        }
      }

      match /activity/{eventId} {
        allow read, write: if isUser(userId);
      }

      match /sharedDecks/{deckId} {
        allow read, write: if isUser(userId);
      }

      match /invites/{inviteId} {
        allow read, write: if isUser(userId);
      }
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }
  }
}
